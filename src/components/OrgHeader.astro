---
// Rung 2's shared header: the organization name and a menu of every page.
import campaign from "../../campaign.config";
import { organization } from "../config";
import { navItems } from "../lib/pages";

const org = organization(campaign);
const items = await navItems();
const here = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={campaign.base}>{org.name}</a>
    <nav aria-label="Primary">
      <ul>
        {
          items.map((item) => {
            const href = `${campaign.base}${item.path}`;
            return (
              <li>
                <a href={href} aria-current={here === href ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-block: 0.85rem;
  }
  .brand {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ink);
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a[href] {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  a:hover,
  a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  a[aria-current="page"] {
    text-decoration-thickness: 2px;
    text-decoration-color: var(--accent);
  }
</style>
