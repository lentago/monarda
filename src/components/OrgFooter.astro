---
// Rung 2's shared footer: social/press links and the small print.
import campaign from "../../campaign.config";
import { organization } from "../config";

const { footerNote, links } = campaign;
const org = organization(campaign);
---

<footer class="site-footer">
  <div class="container">
    {links && links.length > 0 && (
      <nav aria-label="Social and press">
        <ul>
          {links.map((l) => (
            <li>
              <a href={l.url} rel="noopener">{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    {footerNote && <p class="note">{footerNote}</p>}
    <p class="note muted">{org.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 2rem;
    font-size: 0.95rem;
  }
  ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0;
    margin: 0 0 0.75rem;
  }
  .note {
    margin: 0.25rem 0;
  }
</style>
